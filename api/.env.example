MEANINGSYNC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_STORE_RESPONSES=false
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_TRANSCRIPTION_MODEL=gpt-realtime-whisper
MEANINGSYNC_AUDIO_CONSENT_NOTICE_VERSION=audio-transcription-v1
MEANINGSYNC_AUDIO_MAX_TURN_SECONDS=60
MEANINGSYNC_AUDIO_MAX_SESSION_SECONDS_PER_PARTICIPANT=600
MEANINGSYNC_REALTIME_INITIALIZATION_TIMEOUT_SECONDS=12
MEANINGSYNC_AUDIO_IDLE_TIMEOUT_SECONDS=20
MEANINGSYNC_AUDIO_MAX_TRANSCRIPT_LENGTH=2000
MEANINGSYNC_AUDIO_MAX_CONCURRENT_SESSIONS_PER_PARTICIPANT=1
MEANINGSYNC_CLARIFICATION_ATTEMPT_LIMIT=3
MEANINGSYNC_DATABASE_URL=sqlite:///./meaningsync-local.db
MEANINGSYNC_SESSION_TTL_HOURS=24
MEANINGSYNC_ACCESS_TOKEN_TTL_HOURS=24
MEANINGSYNC_INVITE_TTL_MINUTES=15
